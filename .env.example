# Copiar a .env y completar solo lo que uses.
# Los limites de RAM y el modelo los calcula ./bin/up.sh segun la PC.
# Para forzarlos, descomenta la variable.

# ollama = modelo local (privado, usa RAM)
# openai = API compatible con OpenAI (poca RAM, mejor calidad)
AI_BACKEND=ollama

# Solo si AI_BACKEND=openai (OpenAI, OpenRouter, LM Studio, Ollama de otra PC, etc.)
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=
# AI_MODEL=gpt-4.1

# Forzar modelo local. Si se omite, up.sh elige segun la RAM:
#   <12 GB  qwen2.5-coder:3b
#   <24 GB  qwen2.5-coder:7b
#   <40 GB  qwen2.5-coder:14b
#   >=40 GB qwen3-coder:30b
# AI_MODEL=qwen2.5-coder:1.5b

# 1 = Open WebUI. En PCs chicas up.sh lo deja en 0.
# ENABLE_WEBUI=0
WEBUI_PORT=3000

WEB_PORT=8086

# Oracle XE/Free. No se inicia solo: ./bin/up.sh --oracle
# ENABLE_ORACLE=0
ORACLE_PORT=1521
ORACLE_PASSWORD=cambia-esta-clave
ORACLE_USER=dev
ORACLE_APP_PASSWORD=cambia-esta-clave-app
# Dentro de la red Docker el servicio se llama "oracle"
ORACLE_DSN=oracle:1521/FREEPDB1

# Carpeta de claves SSH del host, montada solo lectura en el contenedor
SSH_DIR=./ssh
